<?xml version = "1.0" encoding = "UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:H5App.Pages"
		     xmlns:converters="clr-namespace:H5App.Converters"
			 x:Class="H5App.App">
    <Application.Resources>
        <ResourceDictionary>
            <converters:PriorityToColorConverter x:Key="PriorityToColorConverter" />
            <converters:BoolToStrikeThroughConverter x:Key="BoolToStrikethroughConverter" />
            <converters:BoolToCompletedConverter x:Key="BoolToCompletedConverter" />
            
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
